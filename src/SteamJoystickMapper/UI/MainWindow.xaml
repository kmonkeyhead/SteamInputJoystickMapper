<Window x:Class="SteamJoystickMapper.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SteamJoystickMapper.Localization"
        Title="Monkeyhead Mapper" Width="780" Height="860" MinWidth="640" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <Style x:Key="LangButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <!-- 오른쪽 위: 언어 선택 + 후원하기 -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ToggleButton x:Name="LangKoButton" Content="한국어" Style="{StaticResource LangButton}" Checked="LangKo_Checked" Unchecked="Lang_Unchecked"/>
                <ToggleButton x:Name="LangEnButton" Content="English" Style="{StaticResource LangButton}" Checked="LangEn_Checked" Unchecked="Lang_Unchecked" Margin="0,0,10,0"/>
                <Button x:Name="DonateButton" Content="{Binding [donate], Source={x:Static loc:Loc.Instance}}" Click="Donate_Click"
                        Margin="0" Padding="12,3" FontWeight="SemiBold" Foreground="White" Background="#E0533D" BorderBrush="#C9432F"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Steam Input Joystick Mapper" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="SteamInfoText" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <!-- 프로필 (하나뿐) -->
            <TextBlock Text="{Binding [main.profile], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding [main.import], Source={x:Static loc:Loc.Instance}}" Click="ImportProfile_Click"/>
                    <Button Content="{Binding [main.export], Source={x:Static loc:Loc.Instance}}" Click="ExportProfile_Click"/>
                    <Button Content="{Binding [main.reset], Source={x:Static loc:Loc.Instance}}" Click="ResetProfile_Click" Margin="0"/>
                </StackPanel>
                <TextBlock x:Name="ProfileNameText" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="ProfileSummaryText" Foreground="DimGray" Margin="4,4,0,0" TextWrapping="Wrap"/>

            <!-- 입력 장치 -->
            <TextBlock Text="{Binding [main.device], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding [main.refresh], Source={x:Static loc:Loc.Instance}}" Margin="6,0,0,0" Click="RefreshDevices_Click"/>
                <ComboBox x:Name="DeviceCombo" SelectionChanged="DeviceCombo_SelectionChanged"/>
            </DockPanel>
            <TextBlock x:Name="DeviceDetailsText" Foreground="DimGray" Margin="4,4,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>

            <!-- 대상: 게임 -->
            <TextBlock Text="{Binding [main.games], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameSearchBox" Margin="0,0,6,0" VerticalContentAlignment="Center"
                         TextChanged="GameSearchBox_TextChanged" ToolTip="{Binding [main.searchTip], Source={x:Static loc:Loc.Instance}}"/>
                <TextBlock Text="{Binding [main.search], Source={x:Static loc:Loc.Instance}}" Foreground="Gray" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           x:Name="GameSearchHint"/>
                <ComboBox Grid.Column="1" x:Name="GameCombo" SelectionChanged="GameCombo_SelectionChanged"/>
            </Grid>
            <TextBlock x:Name="TargetText" Margin="4,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="SteamInputText" Margin="4,4,0,0" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="EditButton" Style="{StaticResource PrimaryButton}" Click="EditMapping_Click"/>
                <Button x:Name="RemoveGameButton" Content="{Binding [main.removeMapping], Source={x:Static loc:Loc.Instance}}" Click="RemoveGameMapping_Click"/>
            </WrapPanel>

            <!-- Steam Input 상태 -->
            <TextBlock Text="{Binding [main.status], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding [main.analyze], Source={x:Static loc:Loc.Instance}}" Click="Analyze_Click" Margin="6,0,0,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="Gray" Margin="2,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="-" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusDetailText" Foreground="DimGray" Margin="21,2,0,0" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </DockPanel>

            <WrapPanel Margin="0,14,0,0">
                <Button Content="{Binding [main.apply], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PrimaryButton}" Click="Apply_Click"
                        ToolTip="{Binding [main.applyTip], Source={x:Static loc:Loc.Instance}}"/>
                <Button x:Name="DisableButton" Content="{Binding [main.disable], Source={x:Static loc:Loc.Instance}}" Click="Disable_Click"
                        ToolTip="{Binding [main.disableTip], Source={x:Static loc:Loc.Instance}}"/>
            </WrapPanel>
        </StackPanel>

        <!-- 로그 -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding [main.log], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>
